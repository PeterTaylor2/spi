/* -*-c++-*- */

/**
 * This is an example SPI library containing wrapper functions for the
 * ISDA/CDS C-library.
 *
 * In general we will not be using C++ except for error handling, hence the
 * name CLIB (C-library)
 */

%service test
    namespace=testlib
    dllName="test-dll"
    sharedPtr="spi_boost::shared_ptr"
    sharedPtrInclude="<spi_boost/shared_ptr.hpp>"
    recording=True
    helpFunc=Help;

%export "dateType.cfg";
%export "data.cfg";
%export "wrapper.cfg";
%export "stringType.cfg";

#include <spi/Recording.hpp>
#include <spi_util/FileUtil.hpp>
#include <test_dll_service.hpp>

void startup(dirname)
{
    std::string cwd = spi_util::path::abspath(spi_util::path::getcwd());
    std::string root = cwd;
    std::string dn1;
    // the cwd happens to be different for Windows and other OS'es
    // this is a consequence of the build system
    for (size_t i = 0; i < 5; ++i)
    {
        dn1 = spi_util::path::join(root.c_str(), "test-results", 0);
        if (spi_util::path::isdir(dn1))
            break;
        root = spi_util::path::dirname(root);
    }

    std::string record_dir = spi_util::path::isdir(dn1) ? dn1 : cwd;

    std::cout << "cwd:" << cwd << std::endl;
    std::cout << "dn1:" << dn1 << std::endl;
    std::cout << "record_dir:" << record_dir << std::endl;

    spi::StartRecording(0, "", 0, record_dir, test_version());
}

void shutdown()
{
    spi::StopRecording(test_version());
}


