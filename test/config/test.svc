/* -*-c++-*- */

/**
 * This is an example SPI library containing wrapper functions for the
 * ISDA/CDS C-library.
 *
 * In general we will not be using C++ except for error handling, hence the
 * name CLIB (C-library)
 */

%service test
    namespace=testlib
    dllName="test-dll"
    sharedPtr="spi_boost::shared_ptr"
    sharedPtrInclude="<spi_boost/shared_ptr.hpp>"
    recording=True
    helpFunc=Help;

%export "dateType.cfg";
%export "data.cfg";
%export "wrapper.cfg";
%export "stringType.cfg";

#include <spi/Recording.hpp>
#include <spi_util/FileUtil.hpp>
#include <test_dll_service.hpp>

void startup(dirname)
{
    std::string this_dir = spi_util::path::basename(__FILE__);
    std::string dn1 = spi_util::path::abspath(
		    spi_util::path::join(this_dir.c_str(), "..", "..", "test-results", 0));
    std::string dn2 = spi_util::path::abspath(
		    spi_util::path::join(this_dir.c_str(), "..", 0));

    std::string record_dir = spi_util::path::isdir(dn1) ? dn1 : dn2;
    spi::StartRecording(0, "", 0, record_dir, test_version());
}

void shutdown()
{
    spi::StopRecording(test_version());
}


