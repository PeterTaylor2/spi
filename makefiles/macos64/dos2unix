#!/bin/b
#
# dos2unix - Convert DOS (CRLF) line endings to Unix (LF) in place,
# keeping a .bak backup of each original file. Written for macOS's BSD sed.
#
# Usage: ./dos2unix file1 [file2 file3 ...]

if [ "$#" -eq 0 ]; then
    echo "Usage: $0 file1 [file2 file3 ...]"
    exit 1
fi

for file in "$@"; do
    if [ ! -f "$file" ]; then
        echo "Skipping '$file': not a regular file or does not exist"
        continue
    fi

    # Simply strip any trailing \r before each \n.
    sed -i '.bak' -e $'s/\r$//' "$file"

    echo "Converted: $file (backup saved as $file.bak)"
done
