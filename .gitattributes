# Auto detect text files and perform LF normalization
* text=auto eol=lf

*.bas   text eol=crlf
*.frm   text eol=crlf
*.sln   text eol=crlf
*.psess text eol=crlf
*.csproj          text eol=crlf
*.vcproj          text eol=crlf
*.pyproj          text eol=crlf
*.vcxproj         text eol=crlf
*.vcxproj.filters text eol=crlf
*.props           text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.guid  text eol=crlf

*.frx   binary
*.xlam  binary
  
